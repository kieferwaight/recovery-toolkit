# Location the toolkit is installed/run from on the recovery USB.
INSTALL_DIR="/opt/recovery-toolkit"

# UUID of the recovery USB's root filesystem. Used as an extra write/destructive
# protection guard so scripts refuse to target their own boot device.
# Populate with: findmnt -n -o UUID /
RECOVERY_DISK_UUID=""

# Optional separate hardware-encrypted vault USB. setup-vault installs a
# UUID-bound udev/systemd mount and never adds the device to /etc/fstab.
VAULT_UUID=""
VAULT_MOUNTPOINT="/mnt/Vault"
VAULT_SUBDIR="recovery-toolkit-vault"

# Optional per-host initramfs recovery network profile. The host should use
# DHCP, then verify these reserved values before exposing Dropbear on port 2222.
RECOVERY_INTERFACE=""
RECOVERY_GATEWAY=""
RECOVERY_HOST_IP=""
RECOVERY_SUBNET=""
RECOVERY_SSH_PORT="2222"
RECOVERY_CLIENT_CIDR=""
