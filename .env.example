# Location the toolkit is installed/run from on the recovery USB.
INSTALL_DIR="/opt/recovery-toolkit"

# UUID of the recovery USB's root filesystem. USB Makefile targets display this
# value and refuse a configured mismatch before changing the running USB.
RECOVERY_DISK_UUID=""
RECOVERY_USB_ROOT_UUID=""

# Optional separate hardware-encrypted vault USB. make usb-vault installs a
# UUID-bound udev/systemd mount and never adds the device to /etc/fstab.
VAULT_UUID=""
VAULT_MOUNTPOINT="/mnt/Vault"
VAULT_SUBDIR="recovery-toolkit-vault"

# Optional per-host initramfs recovery network profile. The host should use
# DHCP, then verify these reserved values before exposing Dropbear on port 2222.
RECOVERY_INTERFACE=""
RECOVERY_GATEWAY=""
RECOVERY_HOST_IP=""
RECOVERY_SUBNET=""
RECOVERY_SSH_PORT="2222"
RECOVERY_CLIENT_CIDR=""

# Optional host provisioning profile. provision-luks is read-only by default.
HOST_ID=""
TARGET_DISK=""
EFI_SIZE="1GiB"
BOOT_SIZE="2GiB"
ROOT_VG="ubuntu-vg"
ROOT_LV="ubuntu-lv"
ROOT_FS_LABEL="ubuntu-root"
LUKS_CIPHER="aes-xts-plain64"
LUKS_KEY_SIZE="512"
LUKS_PBKDF="argon2id"

# Ubuntu Server installer handoff. These files must live on the mounted vault.
UBUNTU_INSTALLER_SOURCE="/cdrom"
UBUNTU_IDENTITY_FILE=""
UBUNTU_LUKS_KEY_FILE=""
