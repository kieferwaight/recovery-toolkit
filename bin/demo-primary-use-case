#!/usr/bin/env bash
set -euo pipefail

# Demonstrate a primary intended use case: secure erase, LUKS provisioning,
# Ubuntu Server installation, and Dropbear initramfs unlock setup for a target host.
# Maintains scope to just the fundamental use case requirement.

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_PATH}")" && pwd)"
  SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
  [[ "${SCRIPT_PATH}" != /* ]] && SCRIPT_PATH="${SCRIPT_DIR}/${SCRIPT_PATH}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_PATH}")" && pwd)"
# shellcheck source=../lib/common.sh
source "${SCRIPT_DIR}/../lib/common.sh"
# shellcheck source=../lib/disk_identity.sh
source "${SCRIPT_DIR}/../lib/disk_identity.sh"

TARGET_DISK="${1:-/dev/sdb}"
HOST_ID="$(hostname -s)"
export HOST_ID

if [[ ! -b "${TARGET_DISK}" ]]; then
  log_error "Target ${TARGET_DISK} is not a block device."
  exit 1
fi

metadata="$(disk_identity "${TARGET_DISK}")"
FINGERPRINT="$(disk_identity_fingerprint "${metadata}")"

log_info "1. Secure erase host system SSD"
# ssd-secure-erase verifies that target is not current root and not vault.
# It also detects the proper secure erase method.
echo "NUKE" | ssd-secure-erase "${TARGET_DISK}"

log_info "2. Prepare LUKS layout (first supported layout: GPT EFI + /boot + LUKS2 + LVM + XFS)"
# Generates luks encryption key and stores it on vault implicitly.
echo "${FINGERPRINT}" | provision-luks --target "${TARGET_DISK}" --confirm

log_info "3. Generate SSH keypairs and store on vault"
load_env
VAULT_ROOT="${VAULT_MOUNTPOINT:-/mnt/Vault}/${VAULT_SUBDIR:-recovery-toolkit-vault}"
SSH_DIR="${VAULT_ROOT}/hosts/${HOST_ID}/ssh"
mkdir -p "${SSH_DIR}"
chmod 0700 "${SSH_DIR}"

INITRAMFS_KEY="${SSH_DIR}/initramfs-unlock"
if [[ ! -f "${INITRAMFS_KEY}" ]]; then
  ssh-keygen -t ed25519 -N "" -f "${INITRAMFS_KEY}" -C "initramfs-unlock@${HOST_ID}"
fi
RECOVERY_UNLOCK_KEY="$(cat "${INITRAMFS_KEY}.pub")"
RECOVERY_UNLOCK_KEY_FINGERPRINT="$(ssh-keygen -lf "${INITRAMFS_KEY}.pub" | awk '{print $2}')"
export RECOVERY_UNLOCK_KEY RECOVERY_UNLOCK_KEY_FINGERPRINT

# Prepare OS admin SSH key for Ubuntu identity
OS_KEY="${SSH_DIR}/os-admin"
if [[ ! -f "${OS_KEY}" ]]; then
  ssh-keygen -t ed25519 -N "" -f "${OS_KEY}" -C "admin@${HOST_ID}"
fi

UBUNTU_IDENTITY_FILE="${VAULT_ROOT}/hosts/${HOST_ID}/ubuntu-identity.env"
export UBUNTU_IDENTITY_FILE
# Generate a password hash for default user
PASSWORD_HASH="$(openssl passwd -6 ubuntu)"
cat <<EOF >"${UBUNTU_IDENTITY_FILE}"
UBUNTU_USERNAME=ubuntu
UBUNTU_PASSWORD_HASH=${PASSWORD_HASH}
UBUNTU_SSH_PUBLIC_KEY=$(cat "${OS_KEY}.pub")
EOF
chmod 0600 "${UBUNTU_IDENTITY_FILE}"

# Find the most recently generated LUKS key in the vault for this host
UBUNTU_LUKS_KEY_FILE="$(find "${VAULT_ROOT}/hosts/${HOST_ID}/provisioning" -name "luks.key" -type f -printf "%T@ %p\n" | sort -n | tail -1 | cut -d' ' -f2-)"
export UBUNTU_LUKS_KEY_FILE

log_info "4. Initiate installation of Ubuntu Server"
echo "${FINGERPRINT}" | install-ubuntu-server --target "${TARGET_DISK}" --apply

log_info "5. Decrypt and mount targets as per ubuntu install requirements"
ROOT_VG="${ROOT_VG:-ubuntu-vg}"
ROOT_LV="${ROOT_LV:-ubuntu-lv}"
MAPPER_NAME="recovery-${HOST_ID}-luks"
TARGET_ROOT="/mnt/target-${HOST_ID}"

# Extract partitions based on the created layout
EFI_PARTITION="$(lsblk -nrpo NAME,PARTN "${TARGET_DISK}" | awk '$2 == 1 { print $1; exit }')"
BOOT_PARTITION="$(lsblk -nrpo NAME,PARTN "${TARGET_DISK}" | awk '$2 == 2 { print $1; exit }')"
LUKS_PARTITION="$(lsblk -nrpo NAME,PARTN "${TARGET_DISK}" | awk '$2 == 3 { print $1; exit }')"

cryptsetup open --key-file "${UBUNTU_LUKS_KEY_FILE}" "${LUKS_PARTITION}" "${MAPPER_NAME}"
vgchange -ay "${ROOT_VG}"
mkdir -p "${TARGET_ROOT}"
mount "/dev/${ROOT_VG}/${ROOT_LV}" "${TARGET_ROOT}"
mount "${BOOT_PARTITION}" "${TARGET_ROOT}/boot"
mount "${EFI_PARTITION}" "${TARGET_ROOT}/boot/efi"

# Bind mounts required for chroot and initramfs update
for d in dev proc sys; do
  mount --bind "/$d" "${TARGET_ROOT}/$d"
done

log_info "6. Install dropbear on the target disk and rebuild initramfs"
# Safely pull static wired IP configuration from ip addr show
export RECOVERY_INTERFACE="enp1s0f0"
RECOVERY_HOST_IP="$(ip -4 -o addr show dev "${RECOVERY_INTERFACE}" | awk '{print $4}' | cut -d/ -f1)"
RECOVERY_SUBNET="$(ip route show dev "${RECOVERY_INTERFACE}" scope link | awk '{print $1}' | head -n1)"
RECOVERY_GATEWAY="$(ip route show default dev "${RECOVERY_INTERFACE}" | awk '{print $3}' | head -n1)"
export RECOVERY_HOST_IP RECOVERY_SUBNET RECOVERY_GATEWAY
export RECOVERY_SSH_PORT="2222"

echo "${FINGERPRINT}" | setup-initramfs-unlock --target-root "${TARGET_ROOT}" --apply

log_info "7. Cleanup mounts and close volumes"
for d in dev proc sys boot/efi boot; do
  umount "${TARGET_ROOT}/$d"
done
umount "${TARGET_ROOT}"
vgchange -an "${ROOT_VG}"
cryptsetup close "${MAPPER_NAME}"

log_info "Smoke test passed. You can now try to reboot and remotely unlock using the SSH key saved on vault."
