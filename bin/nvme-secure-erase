#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_PATH}")" && pwd)"
  SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
  [[ "${SCRIPT_PATH}" != /* ]] && SCRIPT_PATH="${SCRIPT_DIR}/${SCRIPT_PATH}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_PATH}")" && pwd)"
# shellcheck source=../lib/common.sh
source "${SCRIPT_DIR}/../lib/common.sh"
# shellcheck source=../lib/audit.sh
source "${SCRIPT_DIR}/../lib/audit.sh"

TARGET="${1:-}"

if [[ -z "${TARGET}" || "${TARGET}" == "-h" || "${TARGET}" == "--help" ]]; then
  echo "Usage: sudo nvme-secure-erase /dev/nvmeXn1"
  echo "Issues a cryptographic scramble or user-data sanitize via nvme-cli."
  exit 1
fi

require_root
load_env
assert_block_device "${TARGET}"
assert_not_boot_disk "${TARGET}"

log_info "Targeting: ${TARGET}"
nvme id-ctrl "${TARGET}" -H | grep -i sanitize || true

confirm_destructive "${TARGET}"
require_audit_vault
target_metadata="$(audit_target_identity "${TARGET}")"
audit_begin 'nvme-secure-erase' "${TARGET}" "${target_metadata}"

log_info "Issuing crypto erase via nvme format..."
erase_status=0
nvme format "${TARGET}" --namespace-id=1 --ses=1 || erase_status=$?
audit_finish "${erase_status}"
if ((erase_status != 0)); then
  log_error "NVMe secure erase failed on ${TARGET}."
  exit "${erase_status}"
fi
log_info "Sanitize complete on ${TARGET}."
