#!/usr/bin/env bash
#TODO make sure we centrailze the variables to work with common and .env
# WARNING, CODE BLINDLY GENERATED BY AI MODEL

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "[-] This script must be run as root." >&2
  exit 1
fi

echo "[+] Step 1: Optimizing /etc/fstab for flash storage..."
ROOT_DEV=$(findmnt -n -o SOURCE /)

# 1. Update root mount options with noatime, lazytime, and commit=60
if ! grep -q "commit=60" /etc/fstab; then
  sed -i -E 's|(\s+ext4\s+)([a-zA-Z0-9_,-]+)|\1\2,noatime,lazytime,commit=60|' /etc/fstab
fi

# 2. Add volatile tmpfs mounts for high-churn paths
declare -A TMP_MOUNTS=(
  ["/tmp"]="size=512M,mode=1777,nosuid,nodev,noexec"
  ["/var/tmp"]="size=256M,mode=1777,nosuid,nodev,noexec"
  ["/var/log"]="size=128M,mode=0755,nosuid,nodev,noexec"
)

for target in "${!TMP_MOUNTS[@]}"; do
  if ! grep -q "[[:space:]]${target}[[:space:]]" /etc/fstab; then
    echo "tmpfs ${target} tmpfs defaults,${TMP_MOUNTS[$target]} 0 0" >> /etc/fstab
    echo "    Added tmpfs entry for ${target}"
  fi
done

echo "[+] Step 2: Tuning sysctl writeback and swap settings..."
cat <<'EOF' > /etc/sysctl.d/99-usb-storage-perf.conf
# Flush small dirty page batches early to avoid choking USB I/O
vm.dirty_background_ratio = 5
vm.dirty_ratio = 10
vm.vfs_cache_pressure = 50
vm.swappiness = 0
EOF
sysctl --system --pattern="^vm\." >/dev/null

echo "[+] Step 3: Configuring volatile in-memory journal..."
mkdir -p /etc/systemd/journald.conf.d
cat <<'EOF' > /etc/systemd/journald.conf.d/00-volatile.conf
[Journal]
Storage=volatile
RuntimeMaxUse=32M
Compress=yes
ForwardToSyslog=no
EOF
systemctl restart systemd-journald

echo "[+] Step 4: Masking high-churn, telemetry, and discovery services..."
SERVICES_TO_MASK=(
  cloud-init.service
  cloud-init-local.service
  cloud-config.service
  cloud-final.service
  unattended-upgrades.service
  apt-daily.timer
  apt-daily-upgrade.timer
  apt-daily.service
  apt-daily-upgrade.service
  ubuntu-advantage.service
  ubuntu-report.service
  whoopsie.service
  apport.service
  motd-news.timer
  motd-news.service
  multipathd.service
  multipathd.socket
  mdmonitor.service
  thermald.service
)

for svc in "${SERVICES_TO_MASK[@]}"; do
  if systemctl list-unit-files "$svc" &>/dev/null; then
    systemctl stop "$svc" 2>/dev/null || true
    systemctl mask "$svc" 2>/dev/null || true
  fi
done

echo "[+] Step 5: Disabling swap..."
swapoff -a || true
sed -i -E '/\sswap\s/d' /etc/fstab

echo "[✔] Base USB optimizations applied successfully."
