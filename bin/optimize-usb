#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "${SCRIPT_DIR}/../lib/common.sh"

require_root
load_env

backup_dir="/root/recovery-toolkit-optimization-$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "${backup_dir}"
cp -a /etc/fstab /etc/sysctl.d "${backup_dir}/"
systemctl list-unit-files --no-pager > "${backup_dir}/unit-files.txt"
if [[ -f /etc/systemd/journald.conf.d/00-volatile.conf ]]; then
  cp -a /etc/systemd/journald.conf.d/00-volatile.conf "${backup_dir}/journald.conf"
fi

log_info "Disabling nonessential background services..."
for unit in snapd.service snapd.socket snapd.seeded.service fwupd-refresh.timer \
  unattended-upgrades.service apt-daily.timer apt-daily-upgrade.timer \
  smartmontools.service nvmefc-boot-connections.service nvmf-autoconnect.service \
  packagekit.service; do
  systemctl disable --now "${unit}" 2>/dev/null || true
done

if dpkg-query -W -f='${Status}' snapd 2>/dev/null | grep -q 'install ok installed'; then
  log_info "Removing unused snapd..."
  export DEBIAN_FRONTEND=noninteractive
  apt-get purge -y snapd
fi
rm -rf /var/cache/snapd /var/lib/snapd /snap

log_info "Configuring RAM-backed temporary paths..."
if ! grep -Eq '^[[:space:]]*tmpfs[[:space:]]+/var/log[[:space:]]' /etc/fstab; then
  printf '%s\n' 'tmpfs /var/log tmpfs defaults,size=128M,mode=0755,nosuid,nodev,noexec 0 0' >> /etc/fstab
fi
if ! grep -Eq '^[[:space:]]*tmpfs[[:space:]]+/var/tmp[[:space:]]' /etc/fstab; then
  printf '%s\n' 'tmpfs /var/tmp tmpfs defaults,size=256M,mode=1777,nosuid,nodev,noexec 0 0' >> /etc/fstab
fi
if ! grep -Eq '^[[:space:]]*tmpfs[[:space:]]+/var/cache/apt[[:space:]]' /etc/fstab; then
  printf '%s\n' 'tmpfs /var/cache/apt tmpfs defaults,size=1G,mode=0755,nosuid,nodev 0 0' >> /etc/fstab
fi

swapoff -a || true
awk '
  /^[[:space:]]*#/ { print; next }
  NF >= 4 && $2 == "/" && $3 == "ext4" {
    $4 = "defaults,noatime,lazytime,commit=60"
  }
  NF >= 3 && $2 == "none" && $3 == "swap" {
    print "# Disabled for USB performance; restore this line to re-enable swap."
    print "# " $0
    next
  }
  { print }
' /etc/fstab > "${backup_dir}/fstab.optimized"
install -m 0644 "${backup_dir}/fstab.optimized" /etc/fstab

cat > /etc/sysctl.d/99-recovery-usb.conf <<'EOF'
# Keep short-lived writes in RAM and bound long flush stalls on the USB root.
vm.dirty_background_bytes = 67108864
vm.dirty_bytes = 268435456
vm.dirty_expire_centisecs = 6000
vm.dirty_writeback_centisecs = 1000
vm.swappiness = 1
vm.vfs_cache_pressure = 50
EOF

mkdir -p /etc/systemd/journald.conf.d
cat > /etc/systemd/journald.conf.d/00-volatile.conf <<'EOF'
[Journal]
Storage=volatile
RuntimeMaxUse=32M
Compress=yes
ForwardToSyslog=no
EOF

sysctl --system >/dev/null
mount -o remount,rw,noatime,lazytime,commit=60 /
mount -a
systemctl daemon-reload
systemctl restart systemd-journald

log_info "USB utility profile applied. Backup: ${backup_dir}"
printf 'Root mount: '; findmnt -no OPTIONS /
printf 'Swap: '; swapon --show || true
printf 'Temporary mounts:\n'
for mountpoint in /var/log /var/tmp /var/cache/apt; do
  findmnt -no TARGET,FSTYPE,OPTIONS "${mountpoint}"
done
