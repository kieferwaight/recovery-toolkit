#!/usr/bin/env bash
# NEEDS CONSIDERABLE REVIEW AND REFACTORING
# WARNING, CODE BLINDLY GENERATED BY AI MODEL
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "[-] This script must be run as root." >&2
  exit 1
fi

echo "[+] Step 1: Installing overlayroot package..."
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq overlayroot

echo "[+] Step 2: Configuring /etc/overlayroot.conf..."
cat <<'EOF' > /etc/overlayroot.conf
overlayroot="tmpfs:swap=0,recurse=0"
EOF

echo "[+] Step 3: Determining root device and UUIDs..."
ROOT_MNT_SRC=$(findmnt -n -o SOURCE /)
ROOT_UUID=$(blkid -s UUID -o value "$ROOT_MNT_SRC" || true)

if [[ -z "$ROOT_UUID" ]]; then
  echo "[-] Could not automatically determine root UUID. Please verify blkid." >&2
  exit 1
fi

echo "[+] Step 4: Writing custom multi-mode GRUB configuration..."
cat <<EOF > /etc/grub.d/40_custom
#!/bin/sh
exec tail -n +3 \$0
# Multi-mode operational profiles for Encrypted USB Bootstrap

menuentry "Ubuntu USB - Ephemeral RAM Mode (Default Provisioning)" {
    search --no-floppy --fs-uuid --set=root ${ROOT_UUID}
    linux /vmlinuz root=UUID=${ROOT_UUID} ro quiet splash overlayroot=tmpfs page_poison=1 init_on_free=1
    initrd /initrd.img
}

menuentry "Ubuntu USB - Persistent Maintenance Mode (Updates & Vault Setup)" {
    search --no-floppy --fs-uuid --set=root ${ROOT_UUID}
    linux /vmlinuz root=UUID=${ROOT_UUID} rw quiet splash overlayroot=disabled
    initrd /initrd.img
}

menuentry "Ubuntu USB - Airgapped Key Ceremony (RAM + Network Blackout)" {
    search --no-floppy --fs-uuid --set=root ${ROOT_UUID}
    linux /vmlinuz root=UUID=${ROOT_UUID} ro quiet splash overlayroot=tmpfs page_poison=1 init_on_free=1 oops=panic modprobe.blacklist=iwlwifi,mac80211,cfg80211,bluetooth,btusb,thunderbolt,firewire-core
    initrd /initrd.img
}
EOF

chmod +x /etc/grub.d/40_custom

echo "[+] Step 5: Updating GRUB default behavior..."
sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=menu/' /etc/default/grub || echo "GRUB_TIMEOUT_STYLE=menu" >> /etc/default/grub
sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=5/' /etc/default/grub || echo "GRUB_TIMEOUT=5" >> /etc/default/grub
sed -i 's/^GRUB_DEFAULT=.*/GRUB_DEFAULT="Ubuntu USB - Ephemeral RAM Mode (Default Provisioning)"/' /etc/default/grub

echo "[+] Step 6: Updating initramfs and GRUB bootloader..."
update-initramfs -u -k all
update-grub

echo "[✔] Overlay and multi-mode boot configuration complete."
