#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/../../lib/common.sh"
# shellcheck source=lib/usb_context.sh
source "${SCRIPT_DIR}/../../lib/usb_context.sh"

require_root
load_env
usb_require_make_context

PACKAGE_FILE="${SCRIPT_DIR}/../../packages/base.apt.list"

echo "==> Updating package indices..."
apt-get update

echo "==> Installing rescue tools from ${PACKAGE_FILE}..."
grep -vE '^\s*#' "${PACKAGE_FILE}" | grep -v '^\s*$' | tr '\n' ' ' | xargs apt-get install -y --no-install-recommends

echo "==> Package installation complete."
